{
  "name": "wf-shrimpseq_v3",
  "id": "wf-shrimpseq_v3",
  "version": "1.0.4",
  "description": "Minimap2 viral screening with water control SimpleRatio reporting",
  "entrypoint": "main.nf",
  "profile": "standard",
  "assets": {
    "schema_input": "assets/schema_input.json"
  },
  "params": {
    "reads": {
      "type": "string",
      "description": "Input FASTQ folder or glob",
      "default": "data"
    },
    "ref": {
      "type": "string",
      "description": "Reference FASTA file",
      "default": "assets/reference.fasta"
    },
    "out_dir": {
      "type": "string",
      "description": "Output directory",
      "default": "results"
    },
    "threads": {
      "type": "integer",
      "description": "Threads for minimap2/samtools",
      "default": 4
    },
    "water_id": {
      "type": "string",
      "description": "Water control sample name (FASTQ filename stem)",
      "default": "water_control"
    },
    "pseudocount": {
      "type": "number",
      "description": "Alpha pseudocount for SimpleRatio",
      "default": 1
    },
    "pos_cutoff": {
      "type": "number",
      "description": "SimpleRatio >= this => POS",
      "default": 10
    },
    "inc_cutoff": {
      "type": "number",
      "description": "SimpleRatio >= this and < pos_cutoff => INC",
      "default": 3
    },
    "env_name": {
      "type": "string",
      "description": "(Advanced) Micromamba environment name",
      "default": "wf_viral_screen_env"
    },
    "mamba_prefix": {
      "type": "string",
      "description": "(Advanced) Where micromamba stores envs/cache. If relative (e.g. .micromamba) it will be resolved under $HOME",
      "default": "~/.micromamba"
    }
  }
}
